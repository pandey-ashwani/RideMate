# RideMate Server Environment Configuration Example
PORT=5000
MONGO_URI=mongodb://localhost:27017/ridemate
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# SMS Provider Configuration (msg91 | twilio | exotel | console)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# MSG91 Provider Credentials
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Twilio Provider Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel Provider Credentials
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Email Provider Configuration (resend | brevo | console)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=support@ridemate.com

# Resend Credentials
RESEND_API_KEY=

# Brevo Credentials
BREVO_API_KEY=
