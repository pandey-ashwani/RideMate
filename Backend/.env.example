# RideMate Ecosystem Environment Configuration Example

# Server & Database Configuration
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ridemate?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Shared Email OTP Service Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=support@ridemate.com

# Optional Email Providers (Resend / Brevo / Console)
# EMAIL_PROVIDER=console
# RESEND_API_KEY=re_123456789
# BREVO_API_KEY=xkeysib-123456789

# Website API URL (Frontend/.env)
# VITE_API_URL=http://localhost:5000/api

# Mobile API URL (Mobile/.env)
# EXPO_PUBLIC_API_URL=http://100.67.228.171:5000/api
